.env.example
# Configuración de Calculadora Confusa

# Flask
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production

# Server
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Logging
LOG_LEVEL=INFO
LOG_FILE=calculadora.log

# Persistencia
HISTORIAL_FILE=historial.json
MAX_HISTORIAL=5

# CORS
CORS_ORIGINS=*

# Aplicación
APP_VERSION=1.0
APP_NAME=Calculadora Confusa
